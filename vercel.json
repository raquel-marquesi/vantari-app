{
  "rewrites": [
    { "source": "/escritorios-juridicos", "destination": "/landing-pages/01-escritorios-juridicos.html" },
    { "source": "/antecipar-agora", "destination": "/landing-pages/02-antecipar-agora.html" },
    { "source": "/antecipar-acao", "destination": "/landing-pages/03-antecipar-acao-trabalhista.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
